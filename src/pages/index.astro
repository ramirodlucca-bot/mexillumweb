---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import Problema from "@/components/sections/Problema.astro";
import QueHacemos from "@/components/sections/QueHacemos.astro";
import Palancas from "@/components/sections/Palancas.astro";
import PorSector from "@/components/sections/PorSector.astro";
import ComoTrabajamos from "@/components/sections/ComoTrabajamos.astro";
import Equipo from "@/components/sections/Equipo.astro";
import ModeloContratacion from "@/components/sections/ModeloContratacion.astro";
import CierreFormulario from "@/components/sections/CierreFormulario.astro";

export const prerender = true;
---

<Layout
  title="Mexillum — Almacenamiento y generación de energía para industria"
  description="Mexillum diseña, financia, construye y opera sistemas de almacenamiento de energía (BESS) y generación solar que protegen el EBITDA de operaciones industriales, comerciales y del sector público en México."
>
  <main>
    <Hero />
    <Problema />
    <QueHacemos />
    <Palancas />
    <PorSector />
    <ComoTrabajamos />
    <Equipo />
    <ModeloContratacion />
    <CierreFormulario />
  </main>
</Layout>
