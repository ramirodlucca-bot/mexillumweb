---
import Button from "@/components/starwind/button/Button.astro";
---

<section class="dark bg-background text-foreground border-b border-border">
  <div class="mx-auto flex min-h-[92vh] max-w-5xl flex-col justify-center px-6 py-24 sm:px-8">
    <p
      data-reveal
      class="font-mono text-xs tracking-[0.2em] text-primary uppercase sm:text-sm"
    >
      Almacenamiento y generación de energía para industria
    </p>

    <h1
      data-reveal
      class="mt-6 max-w-4xl text-4xl leading-[1.08] font-semibold text-balance sm:text-5xl md:text-6xl"
    >
      Resolviste de dónde viene tu energía. Falta resolver qué pasa cuando
      falla — y cuánto te cuesta en el peor momento del día.
    </h1>

    <p data-reveal class="mt-8 max-w-2xl text-lg text-foreground/80 sm:text-xl">
      Mexillum diseña, financia y opera sistemas de almacenamiento (BESS) y
      generación solar que protegen el EBITDA de tu operación. Un solo
      responsable, de la ingeniería a la operación.
    </p>

    <div data-reveal class="mt-10">
      <Button as="a" href="/diagnostico" variant="primary" size="lg">
        Iniciar diagnóstico de mi planta
      </Button>
    </div>
  </div>
</section>
