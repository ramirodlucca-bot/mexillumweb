---
import Button from "@/components/starwind/button/Button.astro";

// El mensaje es único (dirección A, el insight del brief: generación
// resuelta vs. almacenamiento no) — arma el hilo con la sección "El
// problema" que sigue. Solo el fondo fotográfico rota entre las 3 fotos
// disponibles, para mantener movimiento sin diluir la promesa central.
const HERO_KICKER = "Almacenamiento y generación de energía para industria";
const HERO_HEADLINE =
  "Resolviste de dónde viene tu energía. Falta resolver qué pasa cuando falla — y cuánto te cuesta en el peor momento del día.";
const HERO_SUBHEAD =
  "Mexillum diseña, financia y opera sistemas de almacenamiento (BESS) y generación solar que protegen el EBITDA de tu operación. Un solo responsable, de la ingeniería a la operación.";

export const heroImages = [
  "/images/hero/solar-molino.avif",
  "/images/hero/solar-campo.avif",
  "/images/hero/paneles-solares.webp",
];
---

<section class="dark bg-background text-foreground border-b border-border relative overflow-hidden">
  <div
    class="relative flex min-h-[92vh] flex-col justify-center"
    data-hero-carousel
  >
    <div
      class="animate-reveal absolute inset-0 bg-cover bg-center transition-opacity duration-500"
      style={`background-image: url(${heroImages[0]})`}
      data-hero-bg
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 bg-background/70" aria-hidden="true"></div>

    <div class="animate-reveal relative z-10 mx-auto w-full max-w-5xl px-6 py-24 sm:px-8">
      <p class="font-mono text-xs tracking-[0.2em] text-primary uppercase sm:text-sm">
        {HERO_KICKER}
      </p>

      <h1 class="mt-6 max-w-4xl text-4xl leading-[1.08] font-semibold text-balance sm:text-5xl md:text-6xl">
        {HERO_HEADLINE}
      </h1>

      <p class="mt-8 max-w-2xl text-lg text-foreground/80 sm:text-xl">
        {HERO_SUBHEAD}
      </p>

      <div class="mt-10">
        <Button as="a" href="/diagnostico" variant="primary" size="lg">
          Iniciar diagnóstico de mi planta
        </Button>
      </div>
    </div>

    <div class="relative z-10 mx-auto mt-4 flex w-full max-w-5xl items-center gap-5 px-6 pb-2 sm:px-8">
      <button
        type="button"
        data-hero-prev
        aria-label="Imagen anterior"
        class="text-foreground/50 hover:text-foreground flex size-9 items-center justify-center rounded-full border border-border transition-colors"
      >
        ‹
      </button>

      <div class="flex items-center gap-2" role="tablist" aria-label="Imágenes de fondo" data-hero-dots>
        {
          heroImages.map((_, i) => (
            <button
              type="button"
              role="tab"
              data-hero-dot={i}
              aria-label={`Ver imagen ${i + 1} de ${heroImages.length}`}
              class="h-1.5 w-7 rounded-full bg-foreground/25 transition-colors"
            />
          ))
        }
      </div>

      <button
        type="button"
        data-hero-next
        aria-label="Imagen siguiente"
        class="text-foreground/50 hover:text-foreground flex size-9 items-center justify-center rounded-full border border-border transition-colors"
      >
        ›
      </button>
    </div>
  </div>
</section>

<script define:vars={{ heroImages }}>
  const root = document.querySelector("[data-hero-carousel]");
  const bg = root.querySelector("[data-hero-bg]");
  const dots = [...root.querySelectorAll("[data-hero-dot]")];
  const prevBtn = root.querySelector("[data-hero-prev]");
  const nextBtn = root.querySelector("[data-hero-next]");

  let index = 0;
  let timer;

  function render(i) {
    bg.style.backgroundImage = `url(${heroImages[i]})`;
    dots.forEach((d, di) => {
      d.classList.toggle("bg-primary", di === i);
      d.classList.toggle("bg-foreground/25", di !== i);
      d.setAttribute("aria-selected", di === i ? "true" : "false");
    });
  }

  function goTo(i) {
    const next = (i + heroImages.length) % heroImages.length;
    bg.classList.add("opacity-0");
    setTimeout(() => {
      index = next;
      render(index);
      bg.classList.remove("opacity-0");
    }, 500);
  }

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function startTimer() {
    if (reduceMotion) return;
    timer = setInterval(() => goTo(index + 1), 6000);
  }

  function resetTimer() {
    clearInterval(timer);
    startTimer();
  }

  prevBtn.addEventListener("click", () => {
    goTo(index - 1);
    resetTimer();
  });
  nextBtn.addEventListener("click", () => {
    goTo(index + 1);
    resetTimer();
  });
  dots.forEach((d, di) =>
    d.addEventListener("click", () => {
      goTo(di);
      resetTimer();
    }),
  );

  root.addEventListener("mouseenter", () => clearInterval(timer));
  root.addEventListener("mouseleave", resetTimer);

  render(0);
  startTimer();
</script>
