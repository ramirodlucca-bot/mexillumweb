---
import SectionHeader from "@/components/SectionHeader.astro";

const NOMBRE = "Cristian D'Lucca";
const CARGO = "Director Comercial";
const INICIALES = "CD";
---

<section class="dark bg-background text-foreground border-b border-border">
  <div class="mx-auto max-w-5xl px-6 py-24 sm:px-8">
    <SectionHeader kicker="Con quién hablás">
      Un solo interlocutor, con nombre y apellido
    </SectionHeader>

    <div data-reveal class="mt-10 flex items-center gap-5">
      <div
        class="flex size-16 shrink-0 items-center justify-center rounded-full border border-border font-mono text-lg text-primary"
        aria-hidden="true"
      >
        {INICIALES}
      </div>
      <div>
        <p class="text-lg font-semibold">{NOMBRE}</p>
        <p class="font-mono text-sm text-foreground/60">{CARGO}</p>
      </div>
    </div>

    <p class="mt-8 max-w-2xl text-lg text-foreground/80">
      Cuando agendás tu llamada de consulta, hablás directo con {NOMBRE} — no
      con un call center ni una cadena de derivaciones.
    </p>
  </div>
</section>
